# EasyWeb Configuration
DOMAIN=localhost
EMAIL=admin@localhost

# JWT Secret (generate a secure random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Frontend URL (used for redirect after OAuth flows)
FRONTEND_URL=http://localhost:3000
AUTH_COOKIE_DOMAIN=

# Comma separated list of emails or domains (prefix with @) that are allowed to auto-provision on first login.
# Leave empty to allow any verified user (not recommended in production).
ALLOWED_USER_EMAILS=

# Public API base used by the frontend SPA
PUBLIC_API_URL=http://localhost:3001

# OAuth Providers Configuration
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth callback base (change to external https URL in production)
OAUTH_BASE_URL=http://localhost:3001

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Microsoft OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Database
DB_PATH=/app/data/easyweb.db

# Redis
REDIS_URL=redis://redis:6379

# DNS Configuration
UPSTREAM_DNS=8.8.8.8,1.1.1.1
BLOCKLIST_UPDATE_INTERVAL=24

# SSL Configuration
SSL_EMAIL=admin@localhost
SSL_STAGING=false

# Networking
CLOUDFLARE_TUNNEL=false

# Proxy (advanced)
# NGINX_CONFIG_PATH=/app/nginx/includes/proxy_upstreams.inc
# NGINX_SERVER_CONFIG_PATH=/app/nginx/includes/proxy_servers.conf
# NGINX_ROOT_CONFIG_PATH=/app/nginx/includes/proxy_root.inc
# NGINX_CONTAINER_NAME=easyweb-nginx
# NGINX_RELOAD_COMMAND=
# NGINX_DISABLE_DOCKER=false
# NGINX_LOCALHOST_FORWARD_HOST=host.docker.internal

# Rate limiting (set RATE_LIMIT_ENABLED=false to disable completely)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX=1000
